        <circle class="star-near" cx="219" cy="119" r="0.65" />
    </pattern>
</defs>

@* One rect per layer, big enough to cover the view however the camera is turned plus the one tile
   of drift Wrap allows. It is a fill, not geometry, so the size costs nothing beyond the pixels
   that end up on screen. *@
<CameraLayer Camera="Camera" Parallax="0">
    <rect x="-500" y="-500" width="1000" height="1000" fill="url(#sporbits-stars-far)" />
</CameraLayer>

<CameraLayer Camera="Camera" Parallax="0.015f" Wrap="170">
    <rect x="-500" y="-500" width="1000" height="1000" fill="url(#sporbits-stars-mid)" />
</CameraLayer>

<CameraLayer Camera="Camera" Parallax="0.04f" Wrap="230">
    <rect x="-500" y="-500" width="1000" height="1000" fill="url(#sporbits-stars-near)" />
</CameraLayer>

@code {
    [Parameter]
    [EditorRequired]
    public Camera Camera { get; set; } = default!;
}
